# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel (produção).
# Gere os segredos com: npm run keys:generate
# NUNCA versione valores reais.

# Supabase — app: Transaction pooler (porta 6543). Migrações: conexão direta/session (porta 5432).
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Anthropic — chave do workspace da plataforma (somente servidor).
ANTHROPIC_API_KEY=

# Meta — App Settings → Basic → App Secret (valida a assinatura dos webhooks).
META_APP_SECRET=
# Token que você define e informa à Meta ao configurar o webhook (mín. 16 caracteres).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Versão da Graph API usada para enviar mensagens.
WHATSAPP_GRAPH_API_VERSION=v24.0

# 32 bytes em base64 — criptografa os tokens dos números e segredos de webhooks no banco.
# Trocar esta chave invalida as credenciais já salvas.
CREDENTIALS_ENCRYPTION_KEY=

# Protege /api/cron/jobs (a Vercel envia "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Opcionais
# Janela (ms) para agrupar mensagens enviadas em sequência antes de responder.
REPLY_DEBOUNCE_MS=2500
# debug | info | warn | error
LOG_LEVEL=info

# Somente para testes de integração (o banco é apagado e recriado; o nome precisa conter "test").
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/atendimento_test
